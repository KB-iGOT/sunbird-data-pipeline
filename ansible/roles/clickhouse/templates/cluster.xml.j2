<clickhouse>
  <remote_servers>
    <{{ env }}_cluster>
      <shard>
{% for host in groups['clickhouse'] %}
        <replica>
          <host>{{ host }}</host>
          <port>{{ clickhouse_tcp_port }}</port>
        </replica>
{% endfor %}
      </shard>
    </{{ env }}_cluster>
  </remote_servers>

  <distributed_ddl>
    <path>/clickhouse/task_queue/ddl</path>
  </distributed_ddl>

  <zookeeper>
{% for host in groups['clickhouse'] %}
    <node>
      <host>{{ host }}</host>
      <port>{{ keeper_port }}</port>
    </node>
{% endfor %}
  </zookeeper>
</clickhouse>
